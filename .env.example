# ─── Google Sheets vía cuenta de servicio ───────────────────────────
# Configurá estas variables en Vercel (Project → Settings → Environment Variables).
# Para desarrollo local, copiá este archivo a ".env" y completá los valores.

# Email de la cuenta de servicio (campo client_email del JSON de credenciales).
GOOGLE_SERVICE_ACCOUNT_EMAIL=kora-bot@tu-proyecto.iam.gserviceaccount.com

# Clave privada (campo private_key del JSON). Pegá el valor completo, incluyendo
# "-----BEGIN PRIVATE KEY-----" y "-----END PRIVATE KEY-----".
# En Vercel podés pegar el texto con saltos de línea reales; localmente en .env
# usá comillas dobles y \n literales.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID de la hoja de cálculo (la parte de la URL entre /d/ y /edit).
GOOGLE_SHEET_ID=1AbC...tu-spreadsheet-id

# ─── Opcional: código de acceso compartido ──────────────────────────
# Si lo definís, la API exige este código y la app pide "desbloquear" al abrir.
# Dejalo vacío o sin definir para que la app quede abierta (sin código).
# KORA_ACCESS_TOKEN=un-codigo-secreto-para-los-dos
